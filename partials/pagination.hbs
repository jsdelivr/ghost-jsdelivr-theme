<footer class="pagination">
	{{#if prev}}
		<a class="pagination__link newer-posts" href="{{page_url prev}}" aria-label="Newer articles">← Newer</a>
	{{/if}}
	<span class="page-number" aria-current="page">Page {{page}} of {{pages}}</span>
	{{#if next}}
		<a class="pagination__link older-posts" href="{{page_url next}}" aria-label="Older articles">Older →</a>
	{{/if}}
</footer>
