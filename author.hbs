{{!< default}}

<main id="main-content" class="content content--archive">
	{{#author}}
		<header class="archive-header archive-header--author">
			{{#if profile_image}}
				<img class="archive-header__avatar" src="{{img_url profile_image size="s"}}" width="92" height="92" alt="">
			{{/if}}
			<div>
				<p class="eyebrow">Author</p>
				<h1>{{name}}</h1>
				{{#if bio}}<p>{{bio}}</p>{{/if}}
			</div>
		</header>
	{{/author}}
	<h2 id="author-articles" class="screen-reader">Articles</h2>
	<section class="post-feed" aria-labelledby="author-articles">
		{{#foreach posts}}
			{{> "post-card" priority=@first}}
		{{/foreach}}
	</section>
	{{pagination}}
</main>
