{{!< default}}

<main id="main-content" class="content content--archive">
	<header class="archive-header">
		<p class="eyebrow">Topic</p>
		<h1>{{#match tag.slug "announcement"}}Announcements{{else}}{{#match tag.slug "tutorial"}}Tutorials{{else}}{{tag.name}}{{/match}}{{/match}}</h1>
		{{#if tag.description}}<p>{{tag.description}}</p>{{/if}}
	</header>
	<h2 id="topic-articles" class="screen-reader">Articles</h2>
	<section class="post-feed" aria-labelledby="topic-articles">
		{{#foreach posts}}
			{{> "post-card" priority=@first}}
		{{/foreach}}
	</section>
	{{pagination}}
</main>
