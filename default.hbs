<!DOCTYPE html>
<html lang="{{@site.locale}}">
	<head>
		<meta charset="utf-8"/>
		<title>{{meta_title}}</title>
		<meta name="robots" content="noindex">
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<link rel="stylesheet" type="text/css" href="{{asset "styles/main.css"}}"/>

		{{! Ghost outputs important style and meta data with this tag }}
		{{ghost_head}}
	</head>
	<body class="{{body_class}}">
		<a class="skip-link" href="#main-content">Skip to content</a>
		{{> "nav"}}
		<div class="page-wrap{{#if statusCode}} page-wrap--error{{/if}}">
			{{{body}}}
		</div>

		{{#unless statusCode}}
		<footer class="site-footer">
			<div class="site-footer__inner">
				<p class="copyright">&copy; jsdelivr.com, 2012–{{date format="YYYY"}}</p>
				<nav class="footer-nav" aria-label="Footer navigation">
					{{> "links"}}
				</nav>
			</div>
		</footer>
		{{/unless}}

		{{! Ghost outputs important scripts and data with this tag }}
		{{ghost_foot}}

		<script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.11.1/build/highlight.min.js" integrity="sha384-RH2xi4eIQ/gjtbs9fUXM68sLSi99C7ZWBRX1vDrVv6GQXRibxXLbwO2NGZB74MbU" crossorigin="anonymous"></script>
		<script>
			if (window.hljs) {
				window.hljs.highlightAll();
			}
		</script>
	</body>
</html>
