{{!< default}}

<main id="main-content" class="error-page">
	<div class="error-page__orbit" aria-hidden="true"><span>404</span></div>
	<div class="error-page__content">
		<h1>Oops! The page you were looking for doesn’t exist.</h1>
		<p>You may have mistyped the address or the page may have moved.</p>
		<div class="error-page__actions">
			<a class="button button--primary" href="{{@site.url}}">Back to the blog</a>
			<button class="button button--secondary" type="button" data-ghost-search>Search articles</button>
		</div>
	</div>
</main>
