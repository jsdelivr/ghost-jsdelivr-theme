{{!< default}}

{{#post}}
	<main id="main-content" class="content content--post">
		<article class="{{post_class}}">
			<header class="post-header">
				<h1 class="post-title">{{{title}}}</h1>
				<div class="post-card__meta post-header__meta">
					{{#primary_tag}}
						<a class="topic-badge" href="{{url}}">{{name}}</a>
					{{else}}
						<span class="topic-badge">jsDelivr</span>
					{{/primary_tag}}
					<span aria-hidden="true">·</span>
					<span class="post-header__authors">By {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</span>
					<span aria-hidden="true">·</span>
					<time datetime="{{date format='YYYY-MM-DD'}}">{{date format="DD MMM YYYY"}}</time>
					<span aria-hidden="true">·</span>
					<span>{{reading_time}}</span>
				</div>
			</header>

			{{#if feature_image}}
				<figure class="post-feature-image">
					<img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 860px) 100vw, 790px" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
				</figure>
			{{/if}}

			<section class="post-content">
				{{content}}
			</section>

			<section class="post-discussion" aria-labelledby="post-discussion-title">
				<h2 id="post-discussion-title">Comments</h2>
				<div class="giscus-shell">
					<span class="giscus-comment-count" aria-live="polite" aria-atomic="true">0 comments</span>
					<div class="giscus"></div>
				</div>
				<script src="{{asset "js/giscus.js"}}"
					data-theme-url="{{asset "styles/giscus.css"}}"
					data-repo="jsdelivr/ghost-jsdelivr"
					data-repo-id="MDEwOlJlcG9zaXRvcnkxMDMyOTk5MDc="
					data-category="Blog comments"
					data-category-id="DIC_kwDOBig7Q84DDP0W"
					data-mapping="specific"
					data-term="jsdelivr-post-{{comment_id}}"
					data-strict="1"
					data-reactions-enabled="1"
					data-emit-metadata="1"
					data-input-position="top"
					data-lang="en"
					data-loading="lazy"
					async>
				</script>
			</section>
		</article>
	</main>
{{/post}}
