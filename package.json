{
	"name": "jsdelivr",
	"version": "1.0.1",
	"author": {
		"name": "Dmitriy Akulov",
		"email": "dak@prospectone.pl"
	},
	"scripts": {
		"build": "sass assets/styles/scss/main.scss assets/styles/main.css",
		"dist": "npm run build && mkdir -p dist && bestzip dist/ghost-jsdelivr-theme.zip \"*.hbs\" assets partials package.json",
		"ghost:pull-content": "node scripts/pull-public-content.mjs",
		"ghost:setup": "npm run ghost:pull-content && npm run ghost:start && node scripts/setup-local-ghost.mjs",
		"ghost:start": "docker compose up -d",
		"ghost:stop": "docker compose stop",
		"ghost:logs": "docker compose logs -f ghost"
	},
	"keywords": [
		"ghost-theme"
	],
	"devDependencies": {
		"bestzip": "3.0.2",
		"sass": "1.102.0"
	},
	"config": {
		"posts_per_page": 6,
		"card_assets": true,
		"image_sizes": {
			"s": { "width": 360 },
			"m": { "width": 720 },
			"l": { "width": 1200 },
			"xl": { "width": 2000 }
		}
	}
}
